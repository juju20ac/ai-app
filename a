# Unquoted ident, quoted "ident", or <<ENVIRONMENT>> tokens used in migrations.
SQL_IDENTIFIER = (
    r'(?:"[^"]+"|<<ENVIRONMENT>>(?:_[A-Za-z_][\w$]*)?|[A-Za-z_][\w$]*)'
)
# schema.table or database.schema.table
SCHEMA_TABLE_PATTERN = re.compile(
    rf"^{SQL_IDENTIFIER}(?:\s*\.\s*{SQL_IDENTIFIER}){{1,2}}$",
    re.IGNORECASE,
)

CLONE_STATEMENT_PATTERN = re.compile(
    rf"""
    CREATE\s+
    (?:OR\s+REPLACE\s+)?
    (?:TEMP(?:ORARY)?\s+|TRANSIENT\s+)?
    TABLE\s+
    (?:IF\s+NOT\s+EXISTS\s+)?
    (?P<destination>{SQL_IDENTIFIER}(?:\s*\.\s*{SQL_IDENTIFIER})*)
    \s+CLONE\s+
    (?P<source>{SQL_IDENTIFIER}(?:\s*\.\s*{SQL_IDENTIFIER})*)
    """,
    re.IGNORECASE | re.VERBOSE,
)


def strip_sql_comments(sql: str) -> str:
    """Remove -- line comments and /* */ block comments before scanning SQL."""
    without_blocks = re.sub(r"/\*.*?\*/", " ", sql, flags=re.DOTALL)
    return re.sub(r"--.*?$", " ", without_blocks, flags=re.MULTILINE)

def find_clone_statements(sql: str) -> list[tuple[str, str]]:
    """Return (destination, source) pairs for each CREATE TABLE ... CLONE ... statement."""
    cleaned = strip_sql_comments(sql)
    return [
        (match.group("destination"), match.group("source"))
        for match in CLONE_STATEMENT_PATTERN.finditer(cleaned)
    ]

def is_schema_table(identifier: str) -> bool:
    """Return True when identifier is schema.table or database.schema.table."""
    return bool(SCHEMA_TABLE_PATTERN.match(normalize_sql_identifier(identifier)))

def normalize_sql_identifier(identifier: str) -> str:
    return re.sub(r"\s+", "", identifier.strip())
