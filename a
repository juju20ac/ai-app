# Unquoted ident, quoted "ident", or <<ENVIRONMENT>> tokens used in migrations.
SQL_IDENTIFIER = (
    r'(?:"[^"]+"|<<ENVIRONMENT>>(?:_[A-Za-z_][\w$]*)?|[A-Za-z_][\w$]*)'
)
# schema.table or database.schema.table
SCHEMA_TABLE_PATTERN = re.compile(
    rf"^{SQL_IDENTIFIER}(?:\s*\.\s*{SQL_IDENTIFIER}){{1,2}}$",
    re.IGNORECASE,
)

CLONE_STATEMENT_PATTERN = re.compile(
    rf"""
    CREATE\s+
    (?:OR\s+REPLACE\s+)?
    (?:TEMP(?:ORARY)?\s+|TRANSIENT\s+)?
    TABLE\s+
    (?:IF\s+NOT\s+EXISTS\s+)?
    (?P<destination>{SQL_IDENTIFIER}(?:\s*\.\s*{SQL_IDENTIFIER})*)
    \s+CLONE\s+
    (?P<source>{SQL_IDENTIFIER}(?:\s*\.\s*{SQL_IDENTIFIER})*)
    """,
    re.IGNORECASE | re.VERBOSE,
)
def canonicalize_sql_name(identifier: str) -> str:
    """Normalize a qualified name for equality checks (unquoted parts case-insensitive)."""
    normalized = normalize_sql_identifier(identifier)
    parts = re.findall(r'"[^"]+"|[^."]+', normalized)
    return ".".join(
        part if part.startswith('"') and part.endswith('"') else part.upper()
        for part in parts
    )
def schema_tables_are_same(destination: str, source: str) -> bool:
    """Return True when destination and source resolve to the same schema.table."""
    return canonicalize_sql_name(destination) == canonicalize_sql_name(source)




def validate_clone_statement_targets(files: list[Path]) -> list[str]:
    """
    If a SQL file contains CLONE statements, require source and destination
    to be qualified as schema.table (or database.schema.table), and to match.
    """
    issues: list[str] = []
    for file_path in files:
        try:
            content = read_file_text(file_path)
        except OSError as exc:
            issues.append(f"{file_path.name}: could not read file ({exc})")
            continue

        clones = find_clone_statements(content)
        if not clones:
            continue

        for destination, source in clones:
            destination_name = normalize_sql_identifier(destination)
            source_name = normalize_sql_identifier(source)
            destination_ok = is_schema_table(destination)
            source_ok = is_schema_table(source)

            problems: list[str] = []
            if not destination_ok:
                problems.append(f"destination '{destination_name}' is not schema.table")
            if not source_ok:
                problems.append(f"source '{source_name}' is not schema.table")
            if (
                destination_ok
                and source_ok
                and not schema_tables_are_same(destination, source)
            ):
                problems.append(
                    f"source '{source_name}' and destination '{destination_name}' "
                    "do not match"
                )

            if problems:
                issues.append(f"{file_path.name}: {'; '.join(problems)}")
    return issues








def strip_sql_comments(sql: str) -> str:
    """Remove -- line comments and /* */ block comments before scanning SQL."""
    without_blocks = re.sub(r"/\*.*?\*/", " ", sql, flags=re.DOTALL)
    return re.sub(r"--.*?$", " ", without_blocks, flags=re.MULTILINE)

def find_clone_statements(sql: str) -> list[tuple[str, str]]:
    """Return (destination, source) pairs for each CREATE TABLE ... CLONE ... statement."""
    cleaned = strip_sql_comments(sql)
    return [
        (match.group("destination"), match.group("source"))
        for match in CLONE_STATEMENT_PATTERN.finditer(cleaned)
    ]

def is_schema_table(identifier: str) -> bool:
    """Return True when identifier is schema.table or database.schema.table."""
    return bool(SCHEMA_TABLE_PATTERN.match(normalize_sql_identifier(identifier)))

def normalize_sql_identifier(identifier: str) -> str:
    return re.sub(r"\s+", "", identifier.strip())
